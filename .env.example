
# Relay AI — Example environment configuration
# Copy the required values into backend/.env.
# Never commit real API credentials.

# Gemini and Groq credentials
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ordered key pool: Gemini first, Groq second.
# The backend assigns key_1 and key_2 automatically.
LLM_API_KEYS=${GEMINI_API_KEY},${GROQ_API_KEY}

# Local SQLite database
DATABASE_URL=sqlite:///./app.db

# Frontend origins permitted to call the backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required for assignment failover testing
ENABLE_FAILURE_SIMULATION=true
